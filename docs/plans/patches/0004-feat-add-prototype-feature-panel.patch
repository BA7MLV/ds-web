Subject: [PATCH 4/9] feat: add prototype feature panel

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 src/components/feature-panel.jsx | 67 ++++++++++++++++++++++++++++++++
 1 file changed, 67 insertions(+)
 create mode 100644 src/components/feature-panel.jsx

diff --git a/src/components/feature-panel.jsx b/src/components/feature-panel.jsx
new file mode 100644
index 0000000..979d945
--- /dev/null
+++ b/src/components/feature-panel.jsx
@@ -0,0 +1,67 @@
+const FONT_STACK =
+  '-apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", sans-serif'
+
+/**
+ * Presentational feature panel: copy left, large image right.
+ * Designed for sticky horizontal scroll sections.
+ */
+export const FeaturePanel = ({
+  eyebrow,
+  title,
+  description,
+  imageSrc,
+  imageAlt,
+  progressLocal,
+  className = '',
+}) => {
+  const progress =
+    typeof progressLocal === 'number'
+      ? Math.min(1, Math.max(0, progressLocal))
+      : 1
+
+  const fadeStyle =
+    typeof progressLocal === 'number'
+      ? {
+          opacity: 0.55 + progress * 0.45,
+          transform: `translateY(${(1 - progress) * 12}px)`,
+        }
+      : undefined
+
+  return (
+    <section
+      className={`flex h-full w-full flex-col items-center justify-center gap-8 px-6 py-10 md:flex-row md:gap-12 md:px-12 lg:gap-16 lg:px-16 ${className}`.trim()}
+      style={{
+        fontFamily: FONT_STACK,
+        ...fadeStyle,
+      }}
+    >
+      <div className="flex w-full max-w-md shrink-0 flex-col justify-center md:w-[38%] md:max-w-[22rem]">
+        {eyebrow ? (
+          <p className="mb-3 text-[13px] font-semibold uppercase tracking-[0.06em] text-[#86868B]">
+            {eyebrow}
+          </p>
+        ) : null}
+        <h2 className="text-[28px] font-semibold leading-tight tracking-tight text-[#1D1D1F] md:text-[36px] lg:text-[40px]">
+          {title}
+        </h2>
+        {description ? (
+          <p className="mt-4 text-[17px] leading-relaxed text-[#86868B] md:text-[19px]">
+            {description}
+          </p>
+        ) : null}
+      </div>
+
+      <div className="flex min-w-0 flex-1 items-center justify-center">
+        <img
+          src={imageSrc}
+          alt={imageAlt ?? ''}
+          className="h-auto max-h-[70vh] w-full max-w-full object-contain"
+          style={{
+            boxShadow: '0 8px 40px rgba(0, 0, 0, 0.06)',
+          }}
+          draggable={false}
+        />
+      </div>
+    </section>
+  )
+}
