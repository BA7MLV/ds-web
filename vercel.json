{
  "installCommand": "git fetch --unshallow --quiet https://github.com/BA7MLV/ds-web.git || echo '[vercel] unshallow skipped'; npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "docs/.vitepress/dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/demo/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    {
      "source": "/docs/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    { "source": "/user-guide/README", "destination": "/user-guide/", "permanent": true },
    { "source": "/user-guide/01-chat-v2", "destination": "/user-guide/chat", "permanent": true },
    { "source": "/user-guide/02-learning-hub", "destination": "/user-guide/learning-hub", "permanent": true },
    { "source": "/user-guide/02-learning-hub-assets/01-notes", "destination": "/user-guide/notes", "permanent": true },
    { "source": "/user-guide/02-learning-hub-assets/02-textbooks", "destination": "/user-guide/reading-translation", "permanent": true },
    { "source": "/user-guide/02-learning-hub-assets/03-question-bank", "destination": "/user-guide/question-bank", "permanent": true },
    { "source": "/user-guide/02-learning-hub-assets/04-translation-essay", "destination": "/user-guide/reading-translation", "permanent": true },
    { "source": "/user-guide/02-learning-hub-assets/05-mindmap", "destination": "/user-guide/mindmap", "permanent": true },
    { "source": "/user-guide/03-chatanki", "destination": "/user-guide/anki", "permanent": true },
    { "source": "/user-guide/04-settings", "destination": "/user-guide/models", "permanent": true },
    { "source": "/user-guide/05-data-management", "destination": "/user-guide/data-sync", "permanent": true },
    { "source": "/user-guide/06-command-palette", "destination": "/user-guide/productivity", "permanent": true },
    { "source": "/user-guide/07-skills", "destination": "/user-guide/skills-mcp", "permanent": true },
    { "source": "/user-guide/08-todo-pomodoro", "destination": "/user-guide/productivity", "permanent": true },
    { "source": "/user-guide/09-memory", "destination": "/user-guide/research-memory", "permanent": true }
  ]
}
